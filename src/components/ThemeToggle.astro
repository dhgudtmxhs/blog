<button
	type="button"
	class="theme-toggle"
	data-theme-toggle
	aria-label="다크 모드로 전환"
	aria-pressed="false"
>
	<span class="theme-toggle__sun" aria-hidden="true">☀</span>
	<span class="theme-toggle__moon" aria-hidden="true">☾</span>
	<span class="sr-only" data-theme-label>다크 모드로 전환</span>
</button>

<script>
	const storageKey = 'ohstone-theme';
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

	function syncButtons() {
		const dark = document.documentElement.classList.contains('dark');
		const label = dark ? '라이트 모드로 전환' : '다크 모드로 전환';

		buttons.forEach((button) => {
			button.setAttribute('aria-label', label);
			button.setAttribute('aria-pressed', String(dark));
			const labelElement = button.querySelector<HTMLElement>('[data-theme-label]');
			if (labelElement) labelElement.textContent = label;
		});
	}

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const dark = document.documentElement.classList.toggle('dark');
			localStorage.setItem(storageKey, dark ? 'dark' : 'light');
			syncButtons();
		});
	});

	syncButtons();
</script>
