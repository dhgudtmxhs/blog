---
import { getCollection } from 'astro:content';
import { sitePath, tagPath } from '../lib/paths';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const post of posts) {
	for (const tag of new Set(post.data.tags)) {
		counts.set(tag, (counts.get(tag) ?? 0) + 1);
	}
}
const tags = [...counts].sort(([a], [b]) => a.localeCompare(b, 'ko-KR'));
---

<button type="button" class="menu-toggle" popovertarget="topic-menu" aria-label="글 목록 메뉴 열기" aria-controls="topic-menu" aria-expanded="false" title="글 목록">
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
		<path d="M4 6h16M4 12h16M4 18h16" />
	</svg>
</button>

<aside id="topic-menu" class="topic-menu" popover="auto" aria-label="글 목록">
	<header class="topic-menu__header">
		<a class="topic-menu__link" href={sitePath()}>
			<span>전체 글</span><span class="topic-menu__count">{posts.length}</span>
		</a>
	</header>
	<nav aria-label="글 목록 탐색">
		<h3>태그</h3>
		<ul class="topic-menu__list">
			{tags.map(([tag, count]) => (
				<li>
					<a class="topic-menu__link" href={tagPath(tag)} aria-current={Astro.url.pathname === tagPath(tag) ? 'page' : undefined}>
						<span>{tag}</span><span class="topic-menu__count">{count}<span class="sr-only">개의 글</span></span>
					</a>
				</li>
			))}
		</ul>
		{tags.length === 0 && <p class="topic-menu__empty">아직 등록된 태그가 없습니다.</p>}
	</nav>
</aside>

<script>
	const menu = document.querySelector<HTMLElement>('#topic-menu');
	const trigger = document.querySelector<HTMLButtonElement>('[aria-controls="topic-menu"]');
	if (menu && trigger) {
		menu.addEventListener('toggle', () => {
			const open = menu.matches(':popover-open');
			trigger.setAttribute('aria-expanded', String(open));
			trigger.setAttribute('aria-label', open ? '글 목록 메뉴 닫기' : '글 목록 메뉴 열기');
		});
	}
</script>

<style>
	.topic-menu {
		position: fixed;
		inset: calc(var(--header-height) + 1px) auto auto 0;
		width: min(20rem, calc(100% - 3rem));
		max-width: none;
		height: calc(100dvh - var(--header-height) - 1px);
		max-height: calc(100dvh - var(--header-height) - 1px);
		padding: 0;
		margin: 0;
		border: 0;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		color: var(--text);
		background: color-mix(in srgb, var(--text) 2%, var(--bg));
		overflow: hidden;
		transform: translateX(-100%);
		transition:
			transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
			display 240ms allow-discrete,
			overlay 240ms allow-discrete;
	}
	.topic-menu:popover-open {
		display: flex;
		flex-direction: column;
		transform: translateX(0);
	}
	@starting-style {
		.topic-menu:popover-open {
			transform: translateX(-100%);
		}
	}
	.topic-menu nav {
		min-height: 0;
		padding: 0.75rem 1.25rem 1.25rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: none;
	}
	.topic-menu nav::-webkit-scrollbar {
		display: none;
	}
	.topic-menu__header {
		flex-shrink: 0;
		padding: 0.75rem 1.25rem;
		border-bottom: 1px solid var(--line);
	}
	p {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.82rem;
	}
	h3 {
		margin: 0 0.75rem 0.25rem;
		color: var(--muted);
		font-size: 0.82rem;
		font-weight: 600;
	}
	.topic-menu__list {
		padding: 0;
		margin: 0;
		list-style: none;
	}
	.topic-menu__link {
		display: flex;
		min-height: 2.75rem;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.55rem 0.75rem;
		border-radius: 0.45rem;
		font-size: 1rem;
		font-weight: 500;
	}
	.topic-menu__link > span:first-child {
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.topic-menu__link:hover {
		background: var(--surface);
	}
	.topic-menu__link[aria-current='page'] {
		color: var(--accent-hover);
		background: var(--accent-soft);
	}
	.topic-menu__count {
		flex-shrink: 0;
		color: var(--muted);
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
		font-weight: 400;
	}
	.topic-menu__link[aria-current='page'] .topic-menu__count {
		color: inherit;
	}
	@media (max-width: 680px) {
		h3 {
			margin-inline: 0;
		}
		.topic-menu {
			width: 100%;
			border: 0;
		}
		.topic-menu__list {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.25rem 1rem;
		}
		.topic-menu__link {
			min-height: 3rem;
			gap: 0.5rem;
			padding-inline: 0;
		}
	}
	@media (max-width: 359px) {
		.topic-menu__list {
			grid-template-columns: 1fr;
		}
	}
</style>
