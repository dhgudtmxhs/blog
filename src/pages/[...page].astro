---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath, tagPath } from '../lib/paths';

export async function getStaticPaths() {
	const postsPerPage = 8;
	const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
	);
	const totalPages = Math.max(1, Math.ceil(posts.length / postsPerPage));

	return Array.from({ length: totalPages }, (_, index) => {
		const currentPage = index + 1;

		return {
			params: { page: currentPage === 1 ? undefined : `page/${currentPage}` },
			props: {
				posts: posts.slice(index * postsPerPage, currentPage * postsPerPage),
				allPosts: posts,
				currentPage,
				totalPages,
			},
		};
	});
}

interface Props {
	posts: CollectionEntry<'posts'>[];
	allPosts: CollectionEntry<'posts'>[];
	currentPage: number;
	totalPages: number;
}

const { posts, allPosts, currentPage, totalPages } = Astro.props;
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort((a, b) =>
	a.localeCompare(b, 'ko-KR'),
);
const pagePath = (page: number) => (page === 1 ? sitePath() : sitePath(`page/${page}/`));
const pageTitle = currentPage === 1 ? SITE_TITLE : `${currentPage}페이지`;
---

<BaseLayout title={pageTitle} description={SITE_DESCRIPTION}>
	<section class="intro" aria-labelledby="intro-title">
		<h1 id="intro-title">개발하며 배운 것을 차분히 기록합니다.</h1>
		<p class="intro__description">
			실무와 사이드 프로젝트에서 마주친 문제, 해결 과정, 다시 꺼내 볼 기술을 정리합니다.
		</p>
	</section>

	{tags.length > 0 && (
		<nav class="tag-nav" aria-label="태그로 글 찾기">
			<span>Tags</span>
			<ul class="tag-list">
				{tags.map((tag) => (
					<li><a class="tag" href={tagPath(tag)}>#{tag}</a></li>
				))}
			</ul>
		</nav>
	)}

	<section class="post-list" aria-labelledby="latest-posts">
		<div class="section-heading">
			<h2 id="latest-posts">최근 글</h2>
			<span>{allPosts.length}개의 글</span>
		</div>

		{posts.length > 0 ? (
			<>
				<div class="post-list__items">
					{posts.map((post) => <PostCard post={post} />)}
				</div>

				<nav class="pagination" aria-label="글 목록 페이지">
					{currentPage > 1 ? (
						<a class="pagination__link" href={pagePath(currentPage - 1)} rel="prev">
							<span aria-hidden="true">←</span> 이전
						</a>
					) : (
						<span class="pagination__link is-disabled" aria-disabled="true">
							<span aria-hidden="true">←</span> 이전
						</span>
					)}

					<span class="pagination__status" aria-current="page">
						{currentPage} / {totalPages}
					</span>

					{currentPage < totalPages ? (
						<a class="pagination__link" href={pagePath(currentPage + 1)} rel="next">
							다음 <span aria-hidden="true">→</span>
						</a>
					) : (
						<span class="pagination__link is-disabled" aria-disabled="true">
							다음 <span aria-hidden="true">→</span>
						</span>
					)}
				</nav>
			</>
		) : (
			<p class="empty-state">아직 공개된 글이 없습니다.</p>
		)}
	</section>
</BaseLayout>
