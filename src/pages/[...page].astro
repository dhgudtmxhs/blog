---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/paths';

export async function getStaticPaths() {
	const postsPerPage = 8;
	const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
	);
	const totalPages = Math.max(1, Math.ceil(posts.length / postsPerPage));

	return Array.from({ length: totalPages }, (_, index) => {
		const currentPage = index + 1;

		return {
			params: { page: currentPage === 1 ? undefined : `page/${currentPage}` },
			props: {
				posts: posts.slice(index * postsPerPage, currentPage * postsPerPage),
				allPosts: posts,
				currentPage,
				totalPages,
			},
		};
	});
}

interface Props {
	posts: CollectionEntry<'posts'>[];
	allPosts: CollectionEntry<'posts'>[];
	currentPage: number;
	totalPages: number;
}

const { posts, allPosts, currentPage, totalPages } = Astro.props;
const pagePath = (page: number) => (page === 1 ? sitePath() : sitePath(`page/${page}/`));
const pageTitle = currentPage === 1 ? SITE_TITLE : `${currentPage}페이지`;
---

<BaseLayout title={pageTitle} description={SITE_DESCRIPTION}>
	<a class="skip-link" href="#latest-posts">최근 글로 건너뛰기</a>

	<section class="post-list" aria-labelledby="latest-posts">
		<div class="section-heading">
			<h1 id="latest-posts">최근 글</h1>
			<span>{allPosts.length}개의 글</span>
		</div>

		{posts.length > 0 ? (
			<>
				<div class="post-list__items">
					{posts.map((post) => <PostCard post={post} />)}
				</div>

				<nav class="pagination" aria-label="글 목록 페이지">
					{currentPage > 1 ? (
						<a class="pagination__link" href={pagePath(currentPage - 1)} rel="prev">
							<span aria-hidden="true">←</span> 이전
						</a>
					) : (
						<span class="pagination__link is-disabled" aria-disabled="true">
							<span aria-hidden="true">←</span> 이전
						</span>
					)}

					<span class="pagination__status" aria-current="page">
						{currentPage} / {totalPages}
					</span>

					{currentPage < totalPages ? (
						<a class="pagination__link" href={pagePath(currentPage + 1)} rel="next">
							다음 <span aria-hidden="true">→</span>
						</a>
					) : (
						<span class="pagination__link is-disabled" aria-disabled="true">
							다음 <span aria-hidden="true">→</span>
						</span>
					)}
				</nav>
			</>
		) : (
			<p class="empty-state">아직 공개된 글이 없습니다.</p>
		)}
	</section>
</BaseLayout>
