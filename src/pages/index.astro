---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { tagPath } from '../lib/paths';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
	a.localeCompare(b, 'ko-KR'),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro" aria-labelledby="intro-title">
		<p class="eyebrow">Backend development notes</p>
		<h1 id="intro-title">개발하며 배운 것을<br />차분히 기록합니다.</h1>
		<p class="intro__description">
			실무와 사이드 프로젝트에서 마주친 문제, 해결 과정, 다시 꺼내 볼 기술을 정리합니다.
		</p>
	</section>

	{tags.length > 0 && (
		<nav class="tag-nav" aria-label="태그로 글 찾기">
			<span>Tags</span>
			<ul class="tag-list">
				{tags.map((tag) => (
					<li><a class="tag" href={tagPath(tag)}>#{tag}</a></li>
				))}
			</ul>
		</nav>
	)}

	<section class="post-list" aria-labelledby="latest-posts">
		<div class="section-heading">
			<h2 id="latest-posts">최근 글</h2>
			<span>{posts.length}개의 글</span>
		</div>

		{posts.length > 0 ? (
			<div class="post-list__items">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		) : (
			<p class="empty-state">아직 공개된 글이 없습니다.</p>
		)}
	</section>
</BaseLayout>
